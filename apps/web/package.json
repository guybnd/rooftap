    "fuse.js": "^7.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.16.0",
    "mapbox-gl": "^3.24.0",
    "next": "^15.5.28",
    "openai": "^6.39.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
