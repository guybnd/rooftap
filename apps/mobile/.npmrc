# @legendapp/state declares peerOptional expo-sqlite@^15.0.0 (stale SDK-era range);
# Expo SDK 57 needs expo-sqlite@~57.0.1. Without this, EAS Build's from-scratch
# npm install ERESOLVEs on that stale peer range (verified in the HOUP-71 spike,
# .docs/mobile-widget-spike.md).
legacy-peer-deps=true
