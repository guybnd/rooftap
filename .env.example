# Copy this file to .env.local for a normal (Vercel-hosted Supabase) dev setup,
# or to .env at the repo root for self-hosting via `./scripts/self-host-init.sh`
# (NOT `docker compose up` directly) — see .docs/self-hosting.md.

# ── Supabase — required ──────────────────────────────────────────────
# Defaults to the self-hosted flow (bundled `kong` gateway on localhost:8000)
# so a fresh checkout self-hosts with zero edits. Hosted dev (.env.local):
# REPLACE all three with your project's URL/keys —
# https://supabase.com/dashboard/project/_/settings/api
# Self-hosting: leave NEXT_PUBLIC_SUPABASE_URL as-is; NEXT_PUBLIC_SUPABASE_ANON_KEY
# / SUPABASE_SERVICE_ROLE_KEY below are placeholders unused by that flow — the
# compose file derives the real values from ANON_KEY / SERVICE_ROLE_KEY instead
# (see the self-hosted block below).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server-only; used by API routes needing admin access). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Self-hosted Supabase stack — auto-generated, self-host only ─────
# JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY / SECRET_KEY_BASE / REALTIME_DB_ENC_KEY
# are generated by scripts/self-host-init.sh into this file on first boot and
# REUSED on every later boot — never hand-set or regenerate them (regenerating
# invalidates every existing session, RLS-signed token, and live Realtime
# connection). See .docs/self-hosting.md.
JWT_SECRET=auto-generated-on-first-boot
ANON_KEY=auto-generated-on-first-boot
SERVICE_ROLE_KEY=auto-generated-on-first-boot
POSTGRES_PASSWORD=change-me-before-first-boot
SECRET_KEY_BASE=auto-generated-on-first-boot
REALTIME_DB_ENC_KEY=auto-generated-on-first-boot

# ── Self-hosted Supabase stack — operator config, self-host only ────
# All have working defaults (see docker-compose.yml); override only if you
# know you need to (e.g. a port conflict, or exposing beyond localhost).
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
KONG_HTTP_PORT=8000
# Upgrades back up the database to ./backups before applying new migrations;
# the newest MIGRATE_BACKUP_KEEP are kept (scripts/restore-backup.sh restores
# one). MIGRATE_BACKUP=off skips the backup.
# MIGRATE_BACKUP=on
# MIGRATE_BACKUP_KEEP=5
# Optional HTTPS front door (`docker compose --profile https up -d`), needed
# for the phone app. Set to the public or Tailscale hostname and set
# SUPABASE_PUBLIC_URL above to https://<that hostname>. See
# .docs/self-hosting.md "Mobile access".
HOMEUP_DOMAIN=
# Or, with no open ports and nothing to install on the phone, a tunnel
# profile (set SUPABASE_PUBLIC_URL and SITE_URL to the tunnel's https:// URL):
#   docker compose --profile tailscale-funnel up -d   needs TS_AUTHKEY
#   docker compose --profile cloudflare-tunnel up -d  needs CLOUDFLARE_TUNNEL_TOKEN
TS_AUTHKEY=
TS_HOSTNAME=rooftap
CLOUDFLARE_TUNNEL_TOKEN=
APP_PORT=3000
POSTGRES_PORT=5432
JWT_EXPIRY=3600
# Comma-separated extra redirect URLs allowed after auth (feeds
# GOTRUE_URI_ALLOW_LIST on the `auth` service). Leave unset unless you need
# an OAuth/email redirect target beyond SITE_URL above.
ADDITIONAL_REDIRECT_URLS=
# Signup locks itself once the first account exists; set to false to reopen public registration.
GOTRUE_DISABLE_SIGNUP=true
# GoTrue's own default, if unset, is 6 characters. Raised because a self-hosted
# instance's login page is usually reachable from the internet.
GOTRUE_PASSWORD_MIN_LENGTH=8

# ── Modules offered by this server — optional (.docs/modules.md) ────
# Comma-separated module ids this deployment offers: household, calendar,
# checklists, documents, groceries, recipes, costs, setup, search. Unset or
# empty = all. Each household's owner then switches modules on or off in
# Settings > Modules; a module left out here can't be switched on at all.
# Served to web and the native app via /api/public-config, so no app rebuild.
HOMEUP_MODULES=

# ── Mapbox — optional (maps, geocoding, directions; hidden without it) ──
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Web Push / VAPID — optional (FLUX-128) ───────────────────────────
# generate once: npx web-push generate-vapid-keys
# Optional values below are left blank on purpose: a placeholder string is
# treated as a real key (a malformed VAPID key breaks every notify-* send).
# Public key is safe to ship to the client; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The Edge Functions need the same VAPID values set as Supabase secrets:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
# Bare VAPID_PUBLIC_KEY (distinct from NEXT_PUBLIC_VAPID_PUBLIC_KEY above) is
# what the edge-runtime service passes to the notify-* functions server-side —
# operator-set on both hosted and self-hosted flows, same value as the public
# key above.
VAPID_PUBLIC_KEY=
# Hosted Supabase only — leave UNSET on the compose stack. If set, it MUST
# equal SERVICE_ROLE_KEY above (and the seeded Vault service_role_key, see
# self-hosting docs), or every push notification 401s silently: send-push.ts
# checks the bearer against this value first, falling back to
# SUPABASE_SERVICE_ROLE_KEY only when it's unset.
PUSH_NOTIFY_SECRET=

# ── OpenAI — optional (AI features degrade gracefully without it) ───
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Gemini — optional (FLUX-202: recipe photo scan parser) ───
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── OpenRouter — optional, alternate parsing provider (HOUP-43) ──────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Anthropic — optional, alternate parsing provider (HOUP-43) ───────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── ScraperAPI — optional (listing parsing for bot-protected sites) ──
# https://www.scraperapi.com/signup (free tier: 5000 credits/month)
# Required only for parsing listings from sites with bot detection (e.g. realestate.com.au)
SCRAPER_API_KEY=

# ── Shopper prices — optional (HOUP-434) ─────────────────────────────
# SerpApi powers Shopper's price lookups through Google Shopping. Without it,
# households can still add prices by hand. https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Comma-separated Shopper source ids to switch off on this server, e.g.
# "ozbargain,osm-stores" (.docs/shopper-sources.md).
SHOPPER_SOURCES_DISABLED=
# Secret the daily price check (GET /api/shopper/refresh) must be called with,
# as `Authorization: Bearer <secret>`. Vercel Cron sends it automatically.
CRON_SECRET=

# ── Google OAuth (sign-in + Calendar) — optional ─────────────────────
# The SAME OAuth client configured as Supabase's Google provider
# (Dashboard → Authentication → Providers → Google). Needed because refreshing
# a Google refresh_token calls Google's token endpoint directly (not through
# Supabase) and must present the client_id/secret that originally issued it.
# Self-hosters can skip this entirely — local email/password login (see
# .docs/self-hosting.md) needs zero Google config.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Edge Functions need the same values set as Supabase secrets:
#   supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...

# ── Dev/bypass login — optional, secret ──────────────────────────────
# Opt-in escape hatch (the "Dev access" toggle on the login page). Unset =
# route refuses with 503 (no hardcoded fallback). Set BOTH to enable.
# Dev/E2E use only — LEAVE UNSET on any internet-reachable instance. Past the
# credential check, the route builds a service-role admin client and creates
# a <username>@homeup.local account with no rate limiting, timing-safe
# comparison, or lockout. In production (NODE_ENV=production) the route 404s
# unless this is also set to "true" — that 404 is correct-by-design, not a bug.
ALLOW_AUTH_BYPASS=
BYPASS_USERNAME=
BYPASS_PASSWORD=

# ── Server operator allowlist — optional, secret (HOUP-242) ──────────
# Comma-separated emails allowed to manage server-global admin config (the
# API keys panel, parsing provider). Deploy-time ONLY — set by whoever runs
# this container/deployment. Never settable from any in-app UI or admin API,
# and never stored in the database: a user signing into someone else's
# instance and adding their own email in-app must have no path to becoming
# an operator of that instance. Unset = no one qualifies (the operator can
# still seed keys directly via env vars, e.g. OPENAI_API_KEY above).
SERVER_OPERATOR_EMAILS=

# ── Cloudflare R2 document storage — optional, secret ────────────────
# Hosted Rooftap keeps documents in R2 (.docs/r2-storage.md). Leave all four
# unset to keep every file in the bundled Supabase Storage, which is what a
# self-hosted server wants.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
