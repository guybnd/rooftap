supabase/.temp/

# IDE
.vscode/
.idea/

# other AI tools
.gemini/
# .github was ignored wholesale to keep Copilot/AI tool config out of the repo,
# which also silently blocked CI workflows from ever being committed. Ignore the
# directory's *contents* rather than the directory itself (git cannot re-include
# a path whose parent dir is excluded), then re-admit workflows and the
# local actions they use, and the README pictures the public repo ships.
.github/*
!.github/workflows/
!.github/actions/
!.github/readme/

# OS
.DS_Store
Thumbs.db

# misc
*.tsbuildinfo
*.pem

# secrets
.docs/secrets.md


# turborepo local cache
.turbo/

# landing page screen demo build (apps/web/landing-static/demo)
apps/web/landing-static/dist/
apps/web/landing-static/dist-ssr/
apps/web/landing-static/demo/dist/
r2-copy-report-*.json

# self-host pre-migration backups (scripts/apply-migrations.sh)
backups/

# What's new: generated from whats-new/*.md by scripts/whats-new.mjs
packages/core/src/whats-new.generated.ts

# Signing keys never belong in the repo (apps/mobile/android/ is generated
# and ignored as a whole).
*.p12
*.jks
*.keystore

# emergency server swap exports (scripts/server-swap/export-hosted.sh)
server-export/
