# production
build/

# env
.env
.env.local
.env.*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PWA
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js
apps/web/public/workbox-*.js
apps/web/public/workbox-*.js.map

# supabase
supabase/.temp/

# IDE
.vscode/
.idea/

# other AI tools
.gemini/
# .github was ignored wholesale to keep Copilot/AI tool config out of the repo,
# which also silently blocked CI workflows from ever being committed. Ignore the
# directory's *contents* rather than the directory itself (git cannot re-include
# a path whose parent dir is excluded), then re-admit workflows and the
# local actions they use.
.github/*
!.github/workflows/
!.github/actions/

# OS
.DS_Store
Thumbs.db

# misc
*.tsbuildinfo
*.pem

# secrets
.docs/secrets.md

# claude
.claude/settings.local.json

# flux-data orphan mode
.flux/*.md
.flux/config.json
.flux/assets/
.flux/read-state.json
.flux-store/

# turborepo local cache
.turbo/

# landing page screen demo build (apps/web/landing-static/demo)
apps/web/landing-static/dist/
apps/web/landing-static/dist-ssr/
apps/web/landing-static/demo/dist/
r2-copy-report-*.json

# self-host pre-migration backups (scripts/apply-migrations.sh)
backups/
