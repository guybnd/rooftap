{
  "name": "homeup",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke": "turbo run smoke --filter=web",
    "check": "node scripts/whats-new.mjs check && turbo run typecheck test lint",
    "check:web": "turbo run typecheck test smoke --filter=web",
    "db:types": "node scripts/db-types.mjs",
    "new-module": "node scripts/new-module.mjs",
    "postinstall": "node -e \"require('fs').existsSync('scripts/whats-new.mjs') && require('child_process').execFileSync(process.execPath, ['scripts/whats-new.mjs'], { stdio: 'inherit' })\" && (patch-package || node -e \"process.exit(process.env.VERCEL ? 0 : 1)\")"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "turbo": "^2.5.4"
  }
}
