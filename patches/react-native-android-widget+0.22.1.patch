+    /**
+     * HomeUp patch: Android 12+ launchers report the exact sizes a widget is shown at
+     * (OPTION_APPWIDGET_SIZES), one per orientation. The min/max fallback below is an
+     * estimate some launchers get wrong, which drew the widget smaller than its box.
+     * Portrait takes the tallest entry, landscape the widest.
+     */
+    private static SizeF getExactWidgetSize(Context context, int widgetId) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) {
+            return null;
+        }
+        Bundle options = AppWidgetManager.getInstance(context).getAppWidgetOptions(widgetId);
+        ArrayList<SizeF> sizes = options.getParcelableArrayList(AppWidgetManager.OPTION_APPWIDGET_SIZES);
+        Log.d("RNWidgetSize", "widget " + widgetId + " sizes=" + sizes
+            + " min=" + options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_WIDTH) + "x" + options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_HEIGHT)
+            + " max=" + options.getInt(AppWidgetManager.OPTION_APPWIDGET_MAX_WIDTH) + "x" + options.getInt(AppWidgetManager.OPTION_APPWIDGET_MAX_HEIGHT));
+        if (sizes == null || sizes.isEmpty()) {
+            return null;
+        }
+        boolean isPortrait = context.getResources().getConfiguration().orientation == ORIENTATION_PORTRAIT;
+        SizeF best = null;
+        for (SizeF size : sizes) {
+            if (size.getWidth() <= 0 || size.getHeight() <= 0) {
+                continue;
+            }
+            if (best == null
+                || (isPortrait && size.getHeight() > best.getHeight())
